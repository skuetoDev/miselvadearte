# WordPress Core - Ignorar TODO el core
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php
/wp-config-sample.php

# Ignorar TODOS los plugins (incluso los personalizados)
/wp-content/plugins/

# Si necesitas versionar algún plugin personalizado, descoméntalo:
# !/wp-content/plugins/miplugin-personalizado/

# Themes - Ignorar todos excepto tu tema
/wp-content/themes/*
!/wp-content/themes/temaPrueba/

# Uploads y cache
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
*.log
*.tmp

# Base de datos
*.sql
*.sql.gz

# Configuración (importante no subir wp-config.php)
/wp-config.php

# Ignorar archivos específicos
secret.txt
config.php

# Ignorar carpetas completas
node_modules/
dist/
build/

# Ignorar archivos en cualquier subcarpeta
**/debug.log

# Excepciones (¡NO ignorar!)
!important.txt
